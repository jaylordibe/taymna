generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma model/field names stay camelCase (idiomatic TS); the actual
// Postgres tables/columns/enum types are snake_case via @@map/@map, matching
// the convention used across the team's other services.

enum Platform {
  WINDOWS
  LINUX
  MACOS

  @@map("platform")
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  ENDED

  @@map("session_status")
}

model Operator {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("operators")
}

model Machine {
  id   String   @id @default(uuid()) @db.Uuid
  name String
  platform Platform
  /// argon2id hash of the machine's credential secret; null until enrollment completes
  credentialHash      String?   @map("credential_hash")
  credentialRevokedAt DateTime? @map("credential_revoked_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  enrollmentTokens EnrollmentToken[]

  @@map("machines")
}

model EnrollmentToken {
  id        String   @id @default(uuid()) @db.Uuid
  machineId String   @map("machine_id") @db.Uuid
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  /// argon2id hash of the one-time enrollment token
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([machineId])
  @@map("enrollment_tokens")
}

model Session {
  id        String        @id @default(uuid()) @db.Uuid
  machineId String        @map("machine_id") @db.Uuid
  machine   Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  startedAt DateTime      @default(now()) @map("started_at")
  expiresAt DateTime      @map("expires_at")
  endedAt   DateTime?     @map("ended_at")
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([machineId])
  @@map("sessions")
  // A partial unique index enforcing "no conflicting active sessions per
  // machine" is added in a hand-written follow-up migration (see
  // prisma/migrations/*_one_active_session_per_machine/migration.sql) --
  // Prisma's schema DSL cannot express a filtered/partial unique index.
}
