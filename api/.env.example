# For running the API standalone against a local Postgres, e.g.:
#   docker run -d --name taymna-dev-postgres -e POSTGRES_USER=taymna \
#     -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=taymna -p 55432:5432 postgres:17-alpine
# Copy to .env and adjust as needed. See ../.env.example for what each
# variable means -- this file just has development-friendly defaults.

DATABASE_URL=postgresql://taymna:devpassword@localhost:55432/taymna
JWT_SECRET=dev-only-secret-do-not-use-in-production-change-me
PORT=3000
WEB_ORIGIN=http://localhost:3001
HEARTBEAT_TIMEOUT_SECONDS=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=devpassword123
