# Copy to .env and fill in before running `docker compose up -d`.
# See docs/self-hosting.md for the full walkthrough.

# --- Postgres ---
POSTGRES_USER=taymna
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taymna
# Used by the api service; must match the values above. "postgres" is the
# compose service name, resolved on the internal Docker network.
DATABASE_URL=postgresql://taymna:change-me@postgres:5432/taymna

# --- API ---
# Random 32+ byte secret used to sign operator JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me
PORT=3000
# Comma-separated list of origins allowed to call the API -- the address(es)
# browsers use to load the web app, e.g. http://192.168.1.50:3001 on a LAN,
# or https://taymna.example.com on a VPS. Must match NEXT_PUBLIC_API_URL's
# counterpart web origin, not the Docker-internal hostname.
WEB_ORIGIN=http://localhost:3001
# How long a machine can go without a heartbeat before it's shown as offline.
HEARTBEAT_TIMEOUT_SECONDS=60

# --- Initial admin operator (created on first boot if no operator exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Web ---
# Base URL BROWSERS use to reach the API (REST + WebSocket) -- e.g. this
# host's LAN IP (http://192.168.1.50:3000) or a domain (https://api.example.com).
# NOT the Docker-internal "api" hostname; browsers on your phone/laptop can't
# resolve that. This is baked into the web app at build time (Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle), so changing it later
# requires `docker compose build web` again, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:3000
